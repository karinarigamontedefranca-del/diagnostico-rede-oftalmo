<bpmn:outgoing>Flow_72db3692</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_0f33f858" name="Teste lâmpada de fenda - conferir tamanho da lente">
<bpmn:documentation>Lente nao serviu. Enquanto isso, o medico prepara o exame de letras para o teste de grau.</bpmn:documentation>
<bpmn:incoming>Flow_72db3692</bpmn:incoming>
<bpmn:outgoing>Flow_47edc912</bpmn:outgoing>
</bpmn:task>
