<bpmn:startEvent id="Id_8ce75007-f14a-49c9-89a0-3ff5a75fe0d3" name="Inicio - paciente chega na portaria">
<bpmn:outgoing>Id_f9c68fbf-94a1-4ad5-b0aa-7843d40f4d78</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="Id_be3ed8e5-4541-46c0-9cdd-10ab55914f84" name="Paciente chega encaminhado pelo call center / agendamento online">
<bpmn:incoming>Id_f9c68fbf-94a1-4ad5-b0aa-7843d40f4d78</bpmn:incoming>
<bpmn:outgoing>Id_c84a5140-4405-44c8-8649-aea4e4119eae</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_196eb9d9-cd84-4498-96cd-93d9d08bf48f" name="Porteiro identifica o paciente no sistema (córnea) e o direciona para a recepção do primeiro andar">
<bpmn:documentation>Segundo a entrevista, o porteiro lança o paciente para a córnea e o direciona para baixo, onde a recepção o chama.</bpmn:documentation>
<bpmn:incoming>Id_c84a5140-4405-44c8-8649-aea4e4119eae</bpmn:incoming>
<bpmn:outgoing>Id_8d39ba18-0349-4cc4-bace-31fca6d2c0c8</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_5375d9f9-bff7-4d93-898b-c159d6eb951d" name="Recepção recebe o paciente e confere: agendamento, documentos e convênio">
<bpmn:incoming>Id_8d39ba18-0349-4cc4-bace-31fca6d2c0c8</bpmn:incoming>
<bpmn:outgoing>Id_b332eaa4-6e82-40d9-932a-0f977e829738</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_e7e075dc-af34-4a5b-b044-4c0fe4cb65c8" name="Recepção faz a ficha do paciente">
<bpmn:incoming>Id_b332eaa4-6e82-40d9-932a-0f977e829738</bpmn:incoming>
<bpmn:outgoing>Id_499473d5-89e6-4701-8317-006137cb51d0</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_15a23bca-f26c-42ed-8503-84f2637de2b5" name="Paciente leva a ficha e a equipe da córnea a recebe">
<bpmn:documentation>Raia renomeada de "Enfermeira" para "Técnicas da córnea": na transcrição, quem faz os exames são as técnicas do setor. Confirmar o cargo.</bpmn:documentation>
<bpmn:incoming>Id_499473d5-89e6-4701-8317-006137cb51d0</bpmn:incoming>
<bpmn:outgoing>Id_d79847a3-9b62-4500-82d1-74e31831bf55</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="Id_6ed81df5-be2b-4b11-b964-9ec101d93db1" name="Paciente chegou com exames pedidos?">
<bpmn:incoming>Id_d79847a3-9b62-4500-82d1-74e31831bf55</bpmn:incoming>
<bpmn:outgoing>Id_a76a5ff2-8b75-477a-90c5-b14c6cf4fa26</bpmn:outgoing>
<bpmn:outgoing>Id_2db7f90e-5fd4-47e5-bc8c-85852509ebe8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="Id_47923264-4bce-4180-b652-3395be1094af" name="Equipe faz os exames (microscopia, topografia, paquimetria, autorrefração e tonometria)">
<bpmn:documentation>Lista citada na entrevista: microscopia, topografia, paquimetria (trecho pouco claro no áudio), autorrefração e tonometria. O pedido vem da última consulta ou do médico.</bpmn:documentation>
<bpmn:incoming>Id_a76a5ff2-8b75-477a-90c5-b14c6cf4fa26</bpmn:incoming>
<bpmn:outgoing>Id_6b543700-94c2-4138-af1e-a8bcb1fc8cf8</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_8123c7d8-bbe3-48b2-b3d4-b5f30b04e0f9" name="Entender o caso do paciente">
<bpmn:incoming>Id_2db7f90e-5fd4-47e5-bc8c-85852509ebe8</bpmn:incoming>
<bpmn:incoming>Id_6b543700-94c2-4138-af1e-a8bcb1fc8cf8</bpmn:incoming>
<bpmn:outgoing>Id_47cec006-6c96-4dfe-9f68-2a92e4e603d7</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_27ceb70a-3709-4f4f-98b0-4c313d0f655f" name="Biomicroscopia (fundo de olho)">
<bpmn:documentation>Biomicroscopia é o nome do exame (fundo de olho); lâmpada de fenda é o equipamento em que ele é feito.</bpmn:documentation>
<bpmn:incoming>Id_47cec006-6c96-4dfe-9f68-2a92e4e603d7</bpmn:incoming>
<bpmn:outgoing>Id_0234f522-f638-40b1-9a4a-bd2c3550ee7a</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_e1cfd6e6-6e06-4878-a8bf-4bb6644972f7" name="Medir o grau dos óculos do paciente">
<bpmn:documentation>Executado em paralelo à biomicroscopia, a pedido do médico.</bpmn:documentation>
<bpmn:incoming>Id_0234f522-f638-40b1-9a4a-bd2c3550ee7a</bpmn:incoming>
<bpmn:outgoing>Id_e4d58d3b-e22d-4322-ac9a-b0459c53e36c</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_85cca87e-eba1-422d-818f-ea5c6e0c97c0" name="Exame de refração - máquina Grins">
<bpmn:incoming>Id_e4d58d3b-e22d-4322-ac9a-b0459c53e36c</bpmn:incoming>
<bpmn:outgoing>Id_3f4adf40-0bd9-4a70-a4a0-39032956e4dc</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_529dd5bb-292a-4b1a-844a-f688702c3160" name="Preenchimento do relatório">
<bpmn:incoming>Id_3f4adf40-0bd9-4a70-a4a0-39032956e4dc</bpmn:incoming>
<bpmn:outgoing>Id_f640d837-65a8-49f8-84a1-e927e0123f64</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_1f8d30f2-f09c-4229-9354-0c1c3b420900" name="Finaliza a consulta com diagnóstico do paciente, opções de tratamento, tratamento e conduta de acompanhamento (entrega a receita)">
<bpmn:documentation>Conforme a transcrição: não usar "explicação do caso"; finalizar com diagnóstico, opções de tratamento, tratamento e conduta de acompanhamento. A entrega da receita (colírio) foi citada como etapa que faltava: confirmar.</bpmn:documentation>
<bpmn:incoming>Id_f640d837-65a8-49f8-84a1-e927e0123f64</bpmn:incoming>
<bpmn:outgoing>Id_c8d7103a-189b-457b-acc9-de02d9bad6f1</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="Id_90eb5a4c-2d4d-40a1-840a-48dd6ce7d77d" name="Encaminhamentos do médico?">
<bpmn:incoming>Id_c8d7103a-189b-457b-acc9-de02d9bad6f1</bpmn:incoming>
<bpmn:outgoing>Id_0f4fe1e8-f62c-4808-b3d9-809931977b1d</bpmn:outgoing>
<bpmn:outgoing>Id_8bc19fa6-ead1-4257-81e2-6e2b1f61630e</bpmn:outgoing>
<bpmn:outgoing>Id_0148ac9b-2dfb-4a95-baa9-359447f8c5b3</bpmn:outgoing>
<bpmn:outgoing>Id_2d09f92d-69cf-4653-aef4-091f396aedfc</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="Id_fe7ba47a-9e23-4cb1-aa23-f32d9dbeaebc" name="Fim - paciente vai embora">
<bpmn:incoming>Id_0f4fe1e8-f62c-4808-b3d9-809931977b1d</bpmn:incoming>
</bpmn:endEvent>
<bpmn:task id="Id_5a2de679-ab99-472c-911b-98c6545e00c0" name="Paciente volta na recepcionista da córnea para marcar a próxima consulta ou exame">
<bpmn:incoming>Id_8bc19fa6-ead1-4257-81e2-6e2b1f61630e</bpmn:incoming>
<bpmn:outgoing>Id_29a05867-66e3-42cf-9dfe-0aae5fa8d460</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="Id_a95e51b8-dd53-4ad4-bdb2-824136c281ed" name="Fim - paciente agendado">
<bpmn:incoming>Id_29a05867-66e3-42cf-9dfe-0aae5fa8d460</bpmn:incoming>
</bpmn:endEvent>
<bpmn:task id="Id_70a2c40e-4d11-4b0b-8e60-a155be44dfbf" name="Paciente leva a guia de encaminhamento do médico e sobe ao 2º andar (consultoria cirúrgica)">
<bpmn:documentation>Correção (transcrição): o paciente só sobe ao 2º andar quando tem cirurgia. Marcação de consulta e de exame é feita no mesmo andar, na recepção.</bpmn:documentation>
<bpmn:incoming>Id_0148ac9b-2dfb-4a95-baa9-359447f8c5b3</bpmn:incoming>
<bpmn:outgoing>Id_17cb720f-5526-4dc6-b86d-99fa57fdf925</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Id_f7a08030-d58d-48a9-b75b-7bf223b40199" name="Marcação de cirurgia agenda a cirurgia (a agenda do bloco é só da equipe da cirurgia)">
<bpmn:incoming>Id_17cb720f-5526-4dc6-b86d-99fa57fdf925</bpmn:incoming>
<bpmn:outgoing>Id_310ff1e9-19fd-47ac-9424-16829f543270</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="Id_ebd4e6a5-c4de-47b4-a12e-645ea1aedd3f" name="Fim - cirurgia agendada">
<bpmn:incoming>Id_310ff1e9-19fd-47ac-9424-16829f543270</bpmn:incoming>
</bpmn:endEvent>
<bpmn:task id="Id_a6a76563-e9c1-4364-826f-0650899f236f" name="Setor de lente de contato faz o teste de lente no paciente">
<bpmn:incoming>Id_2d09f92d-69cf-4653-aef4-091f396aedfc</bpmn:incoming>
<bpmn:outgoing>Id_cbe6d0c5-a4d4-4e6a-9ff8-5bb47472a7b9</bpmn:outgoing>
</bpmn:task>
