<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_exame-de-cornea" targetNamespace="http://skema.jr/rede-oftalmo">
<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Processo 1 - Exame de cornea 2 (paciente nova) - da portaria à saída" processRef="Process_1" /></bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false"><bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_portaria" name="Portaria">
<bpmn:flowNodeRef>Node_inicio</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_nome</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_lanca</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_recepcao" name="Recepção">
<bpmn:flowNodeRef>Node_chama</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_ficha</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_enfermeira" name="Enfermeira">
<bpmn:flowNodeRef>Node_recebe</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_g_pedido</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_exames</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_g_merge</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_medico" name="Medico / tecnico do exame">
<bpmn:flowNodeRef>Node_entender</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_fenda</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_grau</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_grins</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_relatorio</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_entrega</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_g_agendar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_fim_casa</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_marcacao" name="Marcação (2º andar)">
<bpmn:flowNodeRef>Node_sobe</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_agenda</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Node_fim_agenda</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Node_inicio" name="Inicio - paciente chega na portaria">
<bpmn:outgoing>Flow_1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="Node_nome" name="Paciente informa o nome na portaria">
<bpmn:incoming>Flow_1</bpmn:incoming>
<bpmn:outgoing>Flow_2</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_lanca" name="Porteiro lança o paciente no sistema (córnea) e o direciona para a recepção">
<bpmn:documentation>Segundo a entrevista, o porteiro lança o paciente para a córnea e o direciona para baixo, onde a recepção o chama.</bpmn:documentation>
<bpmn:incoming>Flow_2</bpmn:incoming>
<bpmn:outgoing>Flow_3</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_chama" name="Recepção chama o paciente">
<bpmn:incoming>Flow_3</bpmn:incoming>
<bpmn:outgoing>Flow_4</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_ficha" name="Recepção faz a ficha do paciente">
<bpmn:incoming>Flow_4</bpmn:incoming>
<bpmn:outgoing>Flow_5</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_recebe" name="Paciente leva a ficha e a equipe da córnea a recebe">
<bpmn:documentation>Raia “Enfermeira” assumida a partir de “a gente faz o exame” na entrevista; confirmar o cargo de quem recebe a ficha e faz os exames.</bpmn:documentation>
<bpmn:incoming>Flow_5</bpmn:incoming>
<bpmn:outgoing>Flow_6</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="Node_g_pedido" name="Paciente chegou com exames pedidos?">
<bpmn:incoming>Flow_6</bpmn:incoming>
<bpmn:outgoing>Flow_7</bpmn:outgoing>
<bpmn:outgoing>Flow_8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="Node_exames" name="Equipe faz os exames (microscopia, topografia, paquimetria, autorefrator e tonometria)">
<bpmn:documentation>Lista citada na entrevista: microscopia, topografia, paquimetria (trecho pouco claro no áudio), autorefrator e tonometria. O pedido vem da última consulta ou do médico.</bpmn:documentation>
<bpmn:incoming>Flow_7</bpmn:incoming>
<bpmn:outgoing>Flow_9</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="Node_g_merge">
<bpmn:incoming>Flow_8</bpmn:incoming>
<bpmn:incoming>Flow_9</bpmn:incoming>
<bpmn:outgoing>Flow_10</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="Node_entender" name="Entender o caso do paciente">
<bpmn:incoming>Flow_10</bpmn:incoming>
<bpmn:outgoing>Flow_11</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_fenda" name="Teste na lâmpada de fenda">
<bpmn:incoming>Flow_11</bpmn:incoming>
<bpmn:outgoing>Flow_12</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_grau" name="Medir o grau dos óculos do paciente">
<bpmn:documentation>Executado em paralelo ao teste de lampada de fenda (T2), a pedido do medico.</bpmn:documentation>
<bpmn:incoming>Flow_12</bpmn:incoming>
<bpmn:outgoing>Flow_13</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_grins" name="Exame de refração - máquina Grins">
<bpmn:incoming>Flow_13</bpmn:incoming>
<bpmn:outgoing>Flow_14</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_relatorio" name="Preenchimento do relatório">
<bpmn:incoming>Flow_14</bpmn:incoming>
<bpmn:outgoing>Flow_15</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_entrega" name="Entrega de amostra de colírio, receita e explicação do caso">
<bpmn:incoming>Flow_15</bpmn:incoming>
<bpmn:outgoing>Flow_16</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="Node_g_agendar" name="Médico pediu para agendar?">
<bpmn:incoming>Flow_16</bpmn:incoming>
<bpmn:outgoing>Flow_17</bpmn:outgoing>
<bpmn:outgoing>Flow_18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="Node_fim_casa" name="Fim - paciente vai embora">
<bpmn:incoming>Flow_17</bpmn:incoming>
</bpmn:endEvent>
<bpmn:task id="Node_sobe" name="Paciente sobe ao setor de marcação (2º andar, ao lado da lanchonete)">
<bpmn:documentation>Na entrevista: antes o agendamento era feito na recepção; hoje a marcação fica no andar de cima, para tirar o gargalo de quem espera exame e de quem vai marcar.</bpmn:documentation>
<bpmn:incoming>Flow_18</bpmn:incoming>
<bpmn:outgoing>Flow_19</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="Node_agenda" name="Marcação agenda o que o médico pediu">
<bpmn:incoming>Flow_19</bpmn:incoming>
<bpmn:outgoing>Flow_20</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="Node_fim_agenda" name="Fim - paciente agendado">
<bpmn:incoming>Flow_20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Node_inicio" targetRef="Node_nome" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Node_nome" targetRef="Node_lanca" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Node_lanca" targetRef="Node_chama" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Node_chama" targetRef="Node_ficha" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Node_ficha" targetRef="Node_recebe" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Node_recebe" targetRef="Node_g_pedido" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="Node_g_pedido" targetRef="Node_exames" name="Sim" />
<bpmn:sequenceFlow id="Flow_8" sourceRef="Node_g_pedido" targetRef="Node_g_merge" name="Não" />
<bpmn:sequenceFlow id="Flow_9" sourceRef="Node_exames" targetRef="Node_g_merge" />
<bpmn:sequenceFlow id="Flow_10" sourceRef="Node_g_merge" targetRef="Node_entender" />
<bpmn:sequenceFlow id="Flow_11" sourceRef="Node_entender" targetRef="Node_fenda" />
<bpmn:sequenceFlow id="Flow_12" sourceRef="Node_fenda" targetRef="Node_grau" />
<bpmn:sequenceFlow id="Flow_13" sourceRef="Node_grau" targetRef="Node_grins" />
<bpmn:sequenceFlow id="Flow_14" sourceRef="Node_grins" targetRef="Node_relatorio" />
<bpmn:sequenceFlow id="Flow_15" sourceRef="Node_relatorio" targetRef="Node_entrega" />
<bpmn:sequenceFlow id="Flow_16" sourceRef="Node_entrega" targetRef="Node_g_agendar" />
<bpmn:sequenceFlow id="Flow_17" sourceRef="Node_g_agendar" targetRef="Node_fim_casa" name="Não" />
<bpmn:sequenceFlow id="Flow_18" sourceRef="Node_g_agendar" targetRef="Node_sobe" name="Sim" />
<bpmn:sequenceFlow id="Flow_19" sourceRef="Node_sobe" targetRef="Node_agenda" />
<bpmn:sequenceFlow id="Flow_20" sourceRef="Node_agenda" targetRef="Node_fim_agenda" />
<bpmn:textAnnotation id="Note_1605"><bpmn:text>Tempo registrado no desenho original, só da etapa de consulta (do início do atendimento à entrega): aprox. 16:05</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_2" sourceRef="Note_1605" targetRef="Node_entrega" />
</bpmn:process>
