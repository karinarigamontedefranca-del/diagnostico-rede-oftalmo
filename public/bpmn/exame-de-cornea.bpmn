<bpmn:incoming>Id_665358ba-fe3a-40f2-8b01-95fd6f306df4</bpmn:incoming>
<bpmn:outgoing>Id_4d91c0c1-c01d-4cb4-9919-d92639afa6b8</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="Id_c746205b-5baf-40df-b5d0-8bdb875f131b" name="Fim - paciente com a lente">
