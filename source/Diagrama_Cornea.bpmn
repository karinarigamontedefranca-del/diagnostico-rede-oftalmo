      <outgoing>Flow_2</outgoing>
    </task>
    <task id="Node_lanca" name="Porteiro lança o paciente no sistema (córnea) e o direciona para a recepção">
      <documentation>Segundo a entrevista, o porteiro lança o paciente para a córnea e o direciona para baixo, onde a recepção o chama.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
